KAKAO_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=

# Supabase Dashboard > Connect > Session pooler (port 5432)
# 비밀번호에 특수문자가 있으면 URL 인코딩된 연결 문자열을 사용합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require

# FastAPI 프로세스당 DB 연결 상한(무료 Nano 프로젝트에서는 작게 유지)
DB_POOL_MAX_SIZE=5
